{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"outDir": "out",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "vscode"],
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["extension.ts", "project.ts", "schema.ts", "worker.ts", "webview.ts"]
}

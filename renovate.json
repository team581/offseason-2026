{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "schedule:daily"
  ],
  "semanticCommits": "disabled",
  "labels": ["dependencies"],
  "customDatasources": {
    "wpilib-vendordep": {
      "defaultRegistryUrlTemplate": "{{registryUrl}}",
      "format": "json",
      "transformTemplates": ["{ \"releases\": [{ \"version\": version }] }"]
    }
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["**/vendordeps/*.json"],
      "matchStrings": [
        "jsonUrl ? { \"depName\": name, \"currentValue\": version, \"registryUrl\": jsonUrl }"
      ],
      "datasourceTemplate": "custom.wpilib-vendordep"
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "schedule:daily"
  ],
  "customManagers": [{
    "customType": "jsonata",
    "datasourceTemplate": "custom.wpilib-vendordep",
    "managerFilePatterns": ["**/vendordeps/*.json"],
    "fileFormat": "json",
    "matchStrings": ["jsonUrl ? { \"depName\": name, \"currentValue\": version, \"registryUrl\": jsonUrl }"]
  }],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "groupName": "error-prone",
      "matchSourceUrls": [
        "https://github.com/google/error-prone",
        "https://github.com/PicnicSupermarket/error-prone-support"
      ]
    },
    {
      "groupName": "profiling Python dependencies",
      "matchFileNames": ["shared/src/main/python/profiling/pyproject.toml"],
      "separateMajorMinor": true
    },
    {
      "groupName": "CAD Python dependencies",
      "matchFileNames": ["tools/cad/pyproject.toml"],
      "separateMajorMinor": true
    }
  ],
  "semanticCommits": "disabled",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "labels": ["dependencies"],
  "customDatasources": {"wpilib-vendordep": {
    "defaultRegistryUrlTemplate": "{{registryUrl}}",
    "format": "json",
    "transformTemplates": ["{ \"releases\": [{ \"version\": version }] }"]
  }}
}
